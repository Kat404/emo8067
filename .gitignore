# Build
/target/
**/*.rs.bk

# RE artifacts — large, regenerable, and derived from a proprietary binary
/re/ghidra-project/
/re/out/*/decomp/
/re/extracted*/
/rea-bins/
/re/out/*.log

# Keep the small, human-readable RE deliverables
!/re/FINDINGS.md

# Runtime
*.bak
/crates/core/.scratch

# The skill registry — auto-generated by the tooling, machine-local
.atl/

# The hardware captures are fetched by odd/research/extract_capture_oracle.py, not vendored
odd/research/.captures/

# The full capture oracle is written by the same script and is not vendored
odd/research/capture_oracle_full.txt

# Python bytecode cache
__pycache__/
